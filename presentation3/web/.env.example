# ==========================================
# Licentra - Environment Configuration
# ==========================================

# ------------------------------------------
# 1. Clerk Authentication
# Get your publishable key from: https://dashboard.clerk.com -> API Keys
# ------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# ------------------------------------------
# 2. Neon Serverless Postgres Database
# Get your connection string from: https://console.neon.tech -> Connection Details
# Ensure SSL mode is set to 'require'
# ------------------------------------------
VITE_NEON_DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
